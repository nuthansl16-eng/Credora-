# Public app configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential. NEVER expose this as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Payment routing: mock | auto | razorpay | stripe
# Use mock locally. Use auto in production after both provider paths are configured.
PAYMENT_PROVIDER=mock

# Razorpay server secrets. Required for India live/test checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe server secrets. Required for eligible non-India live/test checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Security / scheduled jobs
CRON_SECRET=
MOCK_PAYMENT_SECRET=
SYSTEM_ACTOR_USER_ID=

# Optional reporting configuration
CHARITY_ALLOCATION_PERCENTAGE=10
